# Anubis Environment Configuration
# Copy to .env and fill in your provider keys

# === OLLAMA CLOUD (BIG models) ===
OLLAMA_API_KEY=your-ollama-cloud-key-here
OLLAMA_BASE_URL=https://ollama.com/v1

# === OLLAMA SMALL / "local" (.251 LAN box) ===
OLLAMA_LAN_URL=http://192.168.1.251:11434
# localhost gemma fallback when .251 is down
OLLAMA_LOCAL_URL=http://localhost:11434

# === Z.AI (optional GLM fallback) ===
ZAI_API_KEY=

# === ANTHROPIC (Claude) ===
ANTHROPIC_API_KEY=sk-ant-

# === GOOGLE (Gemini) ===
GOOGLE_GENERATIVE_AI_API_KEY=

# === OPENAI (GPT) ===
OPENAI_API_KEY=sk-

# === DEEPSEEK ===
DEEPSEEK_API_KEY=sk-

# === GROQ ===
GROQ_API_KEY=gsk_

# === ANUBIS RUNTIME ===
# Model overrides (RA_* wins over ANUBIS_*). Leave empty to use ra.json.
RA_MODEL=                 # override BIG model (e.g. ollama-cloud/glm-5.2)
RA_SMALL_MODEL=           # override small model (e.g. ollama-lan/qwen3.8:latest)
ANUBIS_MODEL=
ANUBIS_DEBUG=false
ANUBIS_LAN_SCAN_TIMEOUT=300
ANUBIS_PLUGINS_ENABLED=true
