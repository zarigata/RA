{
  "$schema": "https://ra.dev/config.json",
  "model": "ollama-cloud/glm-5.2",
  "small_model": "ollama/gemma:latest",
  "profile": "mac-weak",
  "profiles": {
    "mac-weak": {
      "description": "Small on LAN Ollama; BIG on Ollama Cloud (glm-5.2). Set OLLAMA_LAN_URL in .env to your LAN server.",
      "tier_models": {
        "heavy": "ollama-cloud/glm-5.2",
        "code": "ollama-cloud/glm-5.2"
      },
      "agent": {
        "thoth": {},
        "ptah": {
          "model": "ollama-cloud/glm-5.2"
        },
        "maat": {},
        "sekhmet": {},
        "isis": {},
        "seshat": {},
        "horus": {}
      }
    }
  },
  "provider": {
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud (BIG)",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2 (Cloud BIG)"
        },
        "gemma4:31b": {
          "name": "Gemma 4 31B (Cloud)"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Cloud)"
        }
      }
    },
    "ollama-lan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama LAN (small/local)",
      "options": {
        "baseURL": "{env:OLLAMA_LAN_URL}/v1"
      },
      "models": {
        "qwen3.8:latest": {
          "name": "Qwen3.8 (LAN small)",
          "context": 262144
        },
        "qwen3-coder-30b-a3b-instruct-ud-q4_k_xl:latest": {
          "name": "Qwen3 Coder 30B A3B (LAN)",
          "context": 262144
        },
        "flint:latest": {
          "name": "Flint (LAN)",
          "context": 262144
        },
        "gemma4:12b": {
          "name": "Gemma4 12B (LAN)",
          "context": 131072
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama localhost fallback",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma:latest": {
          "name": "Gemma (localhost)"
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local :1234)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {}
    }
  },
  "capability_router": {
    "enabled": true,
    "local_bonus": 1,
    "max_candidates": 3,
    "models": [
      "ollama/gemma:latest",
      "ollama-cloud/glm-5.2",
      "lmstudio/*"
    ]
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "plugin": [
    "horus",
    "vibeguard",
    "dcp",
    "cost-tracker",
    "notify",
    "moa",
    "router",
    "lan",
    "papyrus"
  ],
  "agent": {
    "thoth": {},
    "ptah": {
      "model": "ollama-cloud/glm-5.2"
    },
    "maat": {},
    "sekhmet": {},
    "isis": {},
    "seshat": {},
    "horus": {}
  },
  "moa": {
    "roles": [
      "thoth",
      "ptah",
      "maat",
      "sekhmet"
    ],
    "parallel": true,
    "layers": 2
  },
  "teams": {
    "research-pack": {
      "description": "Broad read-only research: three models propose, maat+sekhmet critique",
      "role": "general",
      "layers": 2
    },
    "security-sweep": {
      "description": "Security-focused mixture: two models propose, security-reviewer + maat critique",
      "role": "general",
      "critics": [
        "security-reviewer",
        "maat"
      ],
      "layers": 2
    },
    "refactor-squad": {
      "description": "Refactor proposals with adversarial review: two models propose, sekhmet + code-reviewer critique",
      "role": "refactorer",
      "critics": [
        "sekhmet",
        "code-reviewer"
      ],
      "layers": 2
    },
    "ship-it": {
      "description": "High-stakes implementation review: two models propose, maat + sekhmet + code-reviewer critique",
      "role": "general",
      "critics": [
        "maat",
        "sekhmet",
        "code-reviewer"
      ],
      "layers": 2
    }
  },
  "routing": {
    "mode": "local-first"
  },
  "context": {
    "adaptive": true,
    "resume_limit": 3,
    "low_watermark": 0.7,
    "critical_watermark": 0.9,
    "min_context_tokens": 8192,
    "server_cap": {
      "ollama-lan": 32768,
      "ollama": 8192,
      "lmstudio": 8192
    }
  },
  "pipeline": {
    "stages": [
      "thoth",
      "ptah",
      "maat",
      "sekhmet",
      "ptah",
      "seshat"
    ]
  },
  "agent_limits": {
    "timeout_ms": 420000,
    "max_calls": 96
  }
}