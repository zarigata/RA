{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.3",
  "default_agent": "forge",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr create*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh repo delete*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm publish*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker system prune*",
      "effect": "deny"
    }
  ],
  "agents": {
    "forge": {
      "model": "zai-coding-plan/glm-5.3",
      "description": "Default outcome-focused coding orchestrator: plans, implements, verifies, searches, and delegates bounded specialist work.",
      "mode": "primary",
      "steps": 140,
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "research",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "architect",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "test",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "review",
          "effect": "allow"
        }
      ],
      "system": "Own the user's requested outcome from inspection through verification. For a sma\u2026"
    }
  },
  "mcp": {
    "timeout": {
      "startup": 30000,
      "catalog": 15000,
      "execution": 120000
    },
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.12.0"
        ],
        "disabled": false,
        "protocol": "auto"
      }
    }
  },
  "plugins": [
    {
      "package": "opencode-dcp@2.0.3",
      "options": {
        "enabled": true,
        "debug": false,
        "allowSubAgents": false,
        "maxContextLimit": "70%",
        "nudgeFrequency": 5,
        "tui": {
          "enabled": true
        }
      }
    },
    "@dietrichgebert/ponytail@5.3.3"
  ],
  "providers": {
    "gto-code": {
      "name": "GTO Private AI (Bonsai + Qwen)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://example.test:7777/v1",
        "apiKey": "REDACTED",
        "timeout": 600000
      },
      "models": {
        "bonsai-code-27b": {
          "name": "Bonsai 2 27B \u2014 Development",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "cost": {
            "input": 0,
            "output": 0,
            "cache": {
              "read": 0,
              "write": 0
            }
          }
        },
        "qwen3.8": {
          "name": "Qwen 3.8 \u2014 120k coding",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 120000,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0,
            "cache": {
              "read": 0,
              "write": 0
            }
          }
        }
      }
    },
    "code-gateway": {
      "name": "Code Gateway",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://servidor.codegateway.online/v1",
        "apiKey": "REDACTED",
        "timeout": 600000
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Cloud Test",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "cost": {
            "input": 0,
            "output": 0,
            "cache": {
              "read": 0,
              "write": 0
            }
          }
        }
      }
    },
    "ollama": {
      "name": "Ollama .78 \u2014 auto-discovered",
      "settings": {
        "baseURL": "http://192.168.1.78:11434/v1",
        "timeout": 600000
      }
    }
  }
}